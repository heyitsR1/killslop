{
  "manifest_version": 3,
  "name": "KillSlop: Hide AI Slop on YouTube, X and LinkedIn",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Hides AI slop on YouTube, X and LinkedIn, using the platforms' own AI labels, account patterns and an open list.",
  "homepage_url": "https://killslop.app",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://x.com/*",
    "https://www.linkedin.com/*",
    "https://api.killslop.app/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/parse.js", "src/content/probe.js", "src/content/youtube.js"],
      "css": ["src/content/youtube.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["src/content/x-page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://x.com/*"],
      "js": [
        "src/content/parse.js",
        "src/content/slopsigns.js",
        "src/content/feed.js",
        "src/content/x.js"
      ],
      "css": ["src/content/feed.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "src/content/parse.js",
        "src/content/slopsigns.js",
        "src/content/feed.js",
        "src/content/linkedin.js"
      ],
      "css": ["src/content/feed.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "KillSlop"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
